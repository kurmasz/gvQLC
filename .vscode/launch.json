{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "extensionHost",
            "request": "launch",
            "name": "Run Extension",
            "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
            "sourceMaps": true,
            "preLaunchTask": "npm: compile",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ]
        }
    ]
}
